rules_version = '2';

// Data model: see src/types/schema.ts (plan-dashboard.md §5).
//
// Both apps read and write Firestore through the Firebase Admin SDK on the server,
// which bypasses these rules. The rules below are the second line of defence: they
// define what a signed-in browser could do with the public web config if it talked to
// Firestore directly.
//
// - Writes are server-only everywhere. Server actions enforce things rules cannot see
//   cleanly (tier limits, unique slugs, prices taken from the product, PAID only via the
//   verified Xendit webhook), so allowing client writes would let a tenant bypass them.
// - Dashboard tenants can read only their own stores, products, vault and orders.
// - The public can read active stores and published products (storefront catalogue).
//   Store secrets (WA token, Xendit sub-account) live in stores/{id}/private/*, which is
//   never readable by clients.
// - Orders are created by the storefront's server route, never directly by browsers:
//   a public `create` rule would let anyone write orders with an arbitrary amount.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    // Owner or an admin the owner added (stores/{id}.admin_uids).
    function managesStore(storeId) {
      let store = get(/databases/$(database)/documents/stores/$(storeId)).data;
      return signedIn() && (store.owner_uid == request.auth.uid || request.auth.uid in store.get('admin_uids', []));
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false; // subscription_tier must never be client-writable
    }

    match /stores/{storeId} {
      allow read: if resource.data.is_active == true
                  || (signedIn() && (resource.data.owner_uid == request.auth.uid
                                     || request.auth.uid in resource.data.get('admin_uids', [])));
      allow write: if false;

      match /private/{doc} {
        allow read, write: if false;
      }
    }

    match /products/{productId} {
      allow read: if resource.data.is_published == true || managesStore(resource.data.store_id);
      allow write: if false;
    }

    match /credentials_vault/{credentialId} {
      allow read: if managesStore(resource.data.store_id);
      allow write: if false;
    }

    match /orders/{orderId} {
      allow read: if managesStore(resource.data.store_id);
      allow write: if false;
    }

    // store_slugs, store_domains and anything else: server-only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
