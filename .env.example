# Copy to .env.local for local development (or run `vercel env pull .env.local`).
# Never commit real values.

# Firebase Admin service account (same project as the dashboard)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Xendit secret API key (Settings → API keys). Needs "Money-in: write" permission.
XENDIT_SECRET_KEY=
# Platform (master) account business ID — destination of the platform-fee split.
# Sellers whose XenPlatform sub-account is LIVE are paid directly; others via the platform.
XENDIT_MASTER_ACCOUNT_ID=
# Without a Xendit key, set PAYMENT_MODE=manual to accept orders that the seller
# confirms by hand in the dashboard. Otherwise checkout is disabled.
# PAYMENT_MODE=manual

# Root domain for store subdomains (toko.<root>). Every other host pointed at this
# deployment is treated as a store's custom domain. Leave empty for path-based
# routing only (/<slug>), e.g. in local development.
NEXT_PUBLIC_ROOT_DOMAIN=
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3000
